<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- net8.0 build rolls forward to any newer runtime; net10.0 is the current LTS. -->
    <RollForward>Major</RollForward>
    <RootNamespace>EfMigrationLint</RootNamespace>
    <AssemblyName>ef-migration-lint</AssemblyName>
    <!-- Ship only English Roslyn resources; translated satellite assemblies are most of the package size. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ef-migration-lint</ToolCommandName>
    <PackageId>EfMigrationLint</PackageId>
    <Version>0.2.0</Version>
    <Authors>EF Migration Lint contributors</Authors>
    <Description>Source-only checks for potentially destructive EF Core migration operations. Reads migration .cs files with Roslyn; never builds your project or connects to a database. Prints readable console output or GitHub Actions annotations.</Description>
    <PackageTags>efcore;entity-framework;migrations;lint;roslyn;github-actions;ci</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/seragAhmed/ef-migration-lint</PackageProjectUrl>
    <RepositoryUrl>https://github.com/seragAhmed/ef-migration-lint</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="EfMigrationLint.Tests" />
  </ItemGroup>

</Project>
